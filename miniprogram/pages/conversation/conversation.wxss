.gate-card {
  border-color: #ffc9b4;
  background: #fffaf8;
}

.check-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #d9dde5;
  background: #ffffff;
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.checkbox-on {
  background: linear-gradient(120deg, #f2542d, #ff8a3d);
  border-color: #f2542d;
}

.check-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.55;
  color: #3c4250;
}
