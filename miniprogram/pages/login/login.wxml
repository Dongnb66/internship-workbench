<view class="login-wrap">
  <view class="login-brand">
    <view class="login-logo">实</view>
    <view>
      <view class="login-title">实习管理工作台</view>
      <view class="small muted">岗位池 · 投递看板 · 沟通台账 · AI 评估</view>
    </view>
  </view>

  <view class="login-sub">登录后数据存在云端，手机上记的跟进和电脑上看到的是同一个账号。</view>

  <view class="chips mb-m">
    <view class="chip {{tab === 'wechat' ? 'chip-on' : ''}}" data-tab="wechat" bindtap="switchTab">微信登录</view>
    <view class="chip {{tab === 'phone' ? 'chip-on' : ''}}" data-tab="phone" bindtap="switchTab">手机号登录 / 注册</view>
  </view>

  <block wx:if="{{tab === 'wechat'}}">
    <view class="card">
      <view class="cell-sub" style="margin-top:0; line-height:1.7;">
        点下面的按钮授权微信登录。第一次用这个微信号会自动创建账号，不用先去注册。
      </view>
      <button class="btn btn-primary mt-m" bindtap="loginWechat" disabled="{{busy}}">
        {{busy ? '登录中…' : '微信一键登录'}}
      </button>
    </view>
  </block>

  <block wx:if="{{tab === 'phone'}}">
    <view class="card">
      <view class="field">
        <view class="field-label">手机号</view>
        <input class="input" type="number" placeholder="11 位手机号" value="{{phone}}" bindinput="onPhoneInput" />
      </view>

      <view class="field">
        <view class="field-label">短信验证码</view>
        <view class="row gap-s">
          <input class="input" style="flex:1" type="number" placeholder="6 位验证码" value="{{code}}" bindinput="onCodeInput" />
          <button class="btn btn-sm" bindtap="sendPhoneCode" disabled="{{busy || countdown > 0}}">
            {{countdown > 0 ? countdown + 's' : (codeSent ? '重新发送' : '获取验证码')}}
          </button>
        </view>
      </view>

      <view class="field">
        <view class="field-label">登录密码（可选）</view>
        <input class="input" password placeholder="第一次使用可顺手设一个，至少 6 位" value="{{password}}" bindinput="onPasswordInput" />
        <view class="field-hint">已有密码的账号留空即可，用短信验证码直接登录。</view>
      </view>

      <button class="btn btn-primary" bindtap="submitPhone" disabled="{{busy}}">
        {{busy ? '处理中…' : '登录 / 注册'}}
      </button>
    </view>
  </block>

  <view wx:if="{{error}}" class="hint hint-error mb-s">{{error}}</view>
  <view wx:if="{{info}}" class="hint hint-ok">{{info}}</view>

  <view class="login-foot">
    微信登录与手机号登录由云服务的认证能力提供。数据按账号隔离，存于云端，可随时在「我的」里退出登录。
  </view>
</view>
